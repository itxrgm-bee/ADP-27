[Unit]
Description=Attendance Gunicorn service
After=network.target postgresql.service
[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/attendance
EnvironmentFile=/opt/attendance/.env
ExecStart=/opt/attendance/.venv/bin/gunicorn config.wsgi:application --workers 3 --bind 127.0.0.1:8000 --access-logfile -
Restart=on-failure
[Install]
WantedBy=multi-user.target
